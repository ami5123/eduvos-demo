{
  "pipeline": {
    "name": "eduvos-demo-pipeline",
    "roleArn": "arn:aws:iam::863761415698:role/eduvos-demo-codepipeline-role",
    "artifactStore": {
      "type": "S3",
      "location": "eduvos-demo-pipeline-863761415698"
    },
    "stages": [
      {
        "name": "Source",
        "actions": [
          {
            "name": "GitHub-Source",
            "actionTypeId": {
              "category": "Source",
              "owner": "AWS",
              "provider": "CodeStarSourceConnection",
              "version": "1"
            },
            "configuration": {
              "ConnectionArn": "arn:aws:codestar-connections:eu-west-1:863761415698:connection/ff898558-f03e-4e70-b7be-2181346e65e7",
              "FullRepositoryId": "ami5123/eduvos-demo",
              "BranchName": "main",
              "OutputArtifactFormat": "CODE_ZIP"
            },
            "outputArtifacts": [
              { "name": "SourceOutput" }
            ]
          }
        ]
      },
      {
        "name": "Build",
        "actions": [
          {
            "name": "CodeBuild-Test",
            "actionTypeId": {
              "category": "Build",
              "owner": "AWS",
              "provider": "CodeBuild",
              "version": "1"
            },
            "configuration": {
              "ProjectName": "eduvos-demo-build"
            },
            "inputArtifacts": [
              { "name": "SourceOutput" }
            ],
            "outputArtifacts": [
              { "name": "BuildOutput" }
            ]
          }
        ]
      }
    ]
  }
}
